# Chat completions through the Command Code gateway. Required.
COMMAND_CODE_KEY=

# Web search (search_web). Required only when a run searches the web.
TAVILY_API_KEY=

# Optional. Per-call timeout for network tools (search_web, wikipedia_search), in ms. Default 8000.
# SIDEKICK_TOOL_TIMEOUT_MS=8000

# Optional. Total attempts per network tool call, including the first. Default 3.
# SIDEKICK_TOOL_RETRIES=3

# Optional. Local retry/timeout events as JSON lines on stderr. Set to "events" to enable.
SIDEKICK_LOG=

# Optional. Hosted tracing (node spans, LLM tokens, tool spans). Off unless LANGSMITH_TRACING=true.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=